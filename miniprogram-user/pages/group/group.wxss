/* 顶部福利横幅 */
.banner {
  position: relative;
  padding: 44rpx 40rpx 100rpx;
  overflow: hidden;
  background: linear-gradient(120deg, #ff7a45 0%, #ff4d24 52%, #f5392f 100%);
}

.banner-glow {
  position: absolute;
  top: -80rpx;
  right: -70rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.banner-title {
  position: relative;
  font-size: 56rpx;
  font-weight: 800;
  font-style: italic;
  letter-spacing: 4rpx;
  color: #ffffff;
  text-shadow: 0 6rpx 14rpx rgba(150, 30, 0, 0.28);
}

.banner-sub {
  position: relative;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #ffe4d8;
}

.banner-emoji {
  position: absolute;
  right: 44rpx;
  bottom: 86rpx;
  font-size: 96rpx;
}

/* 群列表 */
.group-list {
  position: relative;
  margin: -56rpx 24rpx 0;
  padding-bottom: 60rpx;
}

.group-card {
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(120, 60, 20, 0.08);
  overflow: hidden;
}

.group-head {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
}

.group-info {
  flex: 1;
  min-width: 0;
}

.group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.tag {
  margin: 0 10rpx 6rpx 0;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #f5392f;
  background: #fff0ee;
  border-radius: 6rpx;
}

.arrow {
  flex-shrink: 0;
  width: 0;
  height: 0;
  margin-left: 10rpx;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 14rpx solid #cccccc;
  transition: transform 0.2s;
}

.arrow.up {
  transform: rotate(180deg);
}

/* 二维码展开区 */
.group-body {
  padding: 0 20rpx 24rpx;
}

.qr-frame {
  padding: 16rpx;
  border: 2rpx solid #ececec;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
}

.qr {
  width: 380rpx;
  height: 380rpx;
}

.qr-btn {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #ff6a3d, #f5392f);
}

.qr-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
}

.group-note {
  margin-top: 10rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #aaaaaa;
  text-align: center;
}
