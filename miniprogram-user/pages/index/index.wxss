.mall-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 20rpx;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.addr,
.hours {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
