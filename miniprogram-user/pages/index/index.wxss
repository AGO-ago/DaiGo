page {
  background: #f7f7f7;
}

.page {
  padding-bottom: 20rpx;
}

/* 顶部品牌栏 */
.brand-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx 24rpx;
  background: #ff8a4c;
}

.brand-space {
  height: 76rpx;
}

/* 头图 */
.hero {
  padding: 16rpx 24rpx 26rpx;
  background: linear-gradient(160deg, #ff8a4c 0%, #ff6a2f 55%, #ff5722 100%);
  border-radius: 0 0 36rpx 36rpx;
}

.brand-mark {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #ff5722;
  background: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(150, 40, 0, 0.22);
}

.brand-name {
  margin-left: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
  font-style: italic;
  letter-spacing: 2rpx;
  color: #ffffff;
  text-shadow: 0 4rpx 12rpx rgba(150, 40, 0, 0.25);
}

.brand-en {
  font-size: 40rpx;
  color: #ffe9a8;
}

/* 定位 + 购物车 */
.topbar {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.loc {
  display: flex;
  align-items: center;
  max-width: 440rpx;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
}

.loc-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.loc-text {
  font-size: 24rpx;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.loc-chevron {
  width: 22rpx;
  height: 22rpx;
  margin-left: 4rpx;
  flex-shrink: 0;
}

.cart-wrap {
  position: relative;
  flex-shrink: 0;
  margin-left: auto;
  padding: 6rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.cart-entry {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  color: #ffffff;
  background: #ff2d2d;
  border-radius: 14rpx;
}

/* 搜索行 */
.search-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 10rpx 10rpx 10rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(200, 60, 0, 0.18);
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.search-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: #9aa4b2;
}

.search-btn {
  padding: 10rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a5c, #ff5722);
  border-radius: 999rpx;
}

/* 通知条 */
.notice {
  display: flex;
  align-items: center;
  margin: 16rpx 20rpx 0;
  padding: 16rpx 22rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(120, 60, 20, 0.06);
}

.notice-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #b25a2a;
  flex: 1;
}

/* 美食城区块标题 */
.section-title-row {
  display: flex;
  align-items: center;
  margin: 30rpx 24rpx 10rpx;
}

.mall-section-title {
  position: relative;
  padding-left: 18rpx;
  font-size: 34rpx;
  font-weight: 800;
  font-style: italic;
  color: #333333;
}

.mall-section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 8rpx;
  height: 30rpx;
  margin-top: -15rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #ffb03a, #ff5a1f);
}

.mall-section-tag {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #ff5a3c;
  background: #ffece6;
  border-radius: 6rpx;
}

/* 美食城卡片 */
.mall-list {
  margin: 0 20rpx;
}

.mall-card {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(120, 60, 20, 0.06);
}

.mall-head {
  display: flex;
  align-items: flex-start;
}

.mall-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.mall-info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.mall-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mall-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.mall-shop-count {
  font-size: 22rpx;
  color: #ff5a3c;
}

.mall-distance {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.mall-addr {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mall-enter {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #999;
}

/* 档口缩略横滑 */
.shop-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
  display: flex;
}

.shop-thumb {
  flex: 0 0 auto;
  width: 140rpx;
  margin-right: 14rpx;
}

.shop-thumb-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.shop-thumb-name {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #555;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty {
  margin: 60rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.bottom-space {
  height: 40rpx;
}
