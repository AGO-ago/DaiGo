page {
  background: #f6f6f6;
}

.page {
  padding-bottom: 20rpx;
}

/* 顶部定位 + 搜索 */
.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
}

.loc {
  display: flex;
  align-items: center;
  max-width: 300rpx;
}

.loc-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

.loc-text {
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.loc-chevron {
  width: 24rpx;
  height: 24rpx;
  margin-left: 2rpx;
  flex-shrink: 0;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 60rpx;
  margin-left: 16rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #9a9a9a;
}

.cart-wrap {
  position: relative;
  flex-shrink: 0;
  padding-left: 16rpx;
}

.cart-entry {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  color: #ffffff;
  background: #ff2d2d;
  border-radius: 14rpx;
}

/* 通知条 */
.notice {
  display: flex;
  align-items: center;
  margin: 12rpx 20rpx 0;
  padding: 14rpx 20rpx;
  background: #eef4ff;
  border-radius: 12rpx;
}

.notice-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #4a6fa5;
  flex: 1;
}

/* 区块通用 */
.section {
  margin: 16rpx 20rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  display: flex;
  align-items: center;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ef2d3c;
  font-style: italic;
}

.hot-timer {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: #ef2d3c;
  border-radius: 6rpx;
}

.more {
  font-size: 22rpx;
  color: #999;
}

.hot-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
  display: flex;
}

.hot-card {
  flex: 0 0 auto;
  width: 200rpx;
  margin-right: 14rpx;
}

.hot-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.hot-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hot-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.hot-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ef2d3c;
}

.hot-origin {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #b0b0b0;
  text-decoration: line-through;
}

.hot-badge {
  margin-left: 8rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #ff6a3d, #ef2d3c);
  border-radius: 8rpx;
}

/* 美食城区块标题 */
.section-title-row {
  display: flex;
  align-items: center;
  margin: 28rpx 24rpx 8rpx;
}

.mall-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.mall-section-tag {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #ff5a3c;
  background: #ffece6;
  border-radius: 6rpx;
}

/* 美食城卡片 */
.mall-list {
  margin: 0 20rpx;
}

.mall-card {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.mall-head {
  display: flex;
  align-items: flex-start;
}

.mall-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.mall-info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.mall-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mall-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.mall-shop-count {
  font-size: 22rpx;
  color: #ff5a3c;
}

.mall-distance {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.mall-addr {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mall-enter {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #999;
}

/* 档口缩略横滑 */
.shop-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
  display: flex;
}

.shop-thumb {
  flex: 0 0 auto;
  width: 140rpx;
  margin-right: 14rpx;
}

.shop-thumb-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.shop-thumb-name {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #555;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty {
  margin: 60rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.bottom-space {
  height: 40rpx;
}
