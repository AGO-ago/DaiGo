<view class="page">
  <!-- 品牌栏（固定左上角） -->
  <view class="brand-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="brand-mark">代</view>
    <view class="brand-name">代<text class="brand-en">go</text></view>
  </view>
  <view style="height: {{statusBarHeight}}px"></view>
  <view class="brand-space"></view>

  <!-- 头图：定位 + 搜索 -->
  <view class="hero">
    <!-- 定位 + 购物车 -->
    <view class="topbar">
      <view class="loc" bindtap="chooseLocation">
        <image class="loc-icon" src="{{icons.locationWhite}}" />
        <text class="loc-text">{{location}}</text>
        <image class="loc-chevron" src="{{icons.chevronWhite}}" />
      </view>
      <view class="cart-wrap" bindtap="openCart">
        <image class="cart-entry" src="{{icons.cartWhite}}" />
        <text class="cart-badge" wx:if="{{cartCount}}">{{cartCount}}</text>
      </view>
    </view>

    <!-- 搜索 -->
    <view class="search-row" bindtap="goSearch">
      <image class="search-icon" src="{{icons.search}}" />
      <text class="search-placeholder">搜索店铺、美食</text>
      <view class="search-btn">搜索</view>
    </view>
  </view>

  <!-- 通知条 -->
  <view class="notice" wx:if="{{homeNotice}}">
    <text class="notice-icon">🔔</text>
    <text class="notice-text">{{homeNotice}}</text>
  </view>

  <!-- 美食城列表 -->
  <view class="section-title-row">
    <text class="mall-section-title">美食城</text>
    <text class="mall-section-tag">档口</text>
  </view>

  <view class="mall-list">
    <view class="mall-card" wx:for="{{malls}}" wx:key="id"
          data-mall-id="{{item.id}}" data-mall-name="{{item.name}}" bindtap="goMall">
      <view class="mall-head">
        <image class="mall-logo" src="{{item.coverImg}}" mode="aspectFill" />
        <view class="mall-info">
          <view class="mall-name">{{item.name}}</view>
          <view class="mall-meta">
            <text class="mall-shop-count">{{item.shopCount}}个档口</text>
            <text class="mall-distance" wx:if="{{item.distance !== null}}">{{item.distance}}km</text>
          </view>
          <view class="mall-addr">{{item.address}}</view>
        </view>
        <view class="mall-enter">进店 ›</view>
      </view>

      <scroll-view class="shop-scroll" scroll-x enable-flex wx:if="{{item.shops.length}}">
        <view class="shop-thumb" wx:for="{{item.shops}}" wx:for-item="shop" wx:key="id"
              data-mall-id="{{item.id}}" data-shop-id="{{shop.id}}" data-shop-name="{{shop.name}}" catchtap="goShop">
          <image class="shop-thumb-img" src="{{shop.logo}}" mode="aspectFill" />
          <view class="shop-thumb-name">{{shop.name}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !malls.length}}">暂无美食城，请先在后台维护数据</view>
  <view class="bottom-space"></view>

  <cart-popup visible="{{cartVisible}}" bind:close="closeCart" bind:change="onCartChange" />
</view>
