<view class="page">
  <!-- 美食城头部 -->
  <view class="mall-head" wx:if="{{mall}}">
    <image class="mall-logo" src="{{mall.coverImg}}" mode="aspectFill" />
    <view class="mall-info">
      <view class="mall-name">{{mall.name}}</view>
      <view class="mall-tags">
        <text class="tag">{{mall.shopCount}}个档口</text>
        <text class="tag" wx:if="{{mall.distance !== null}}">{{mall.distance}}km</text>
        <text class="tag">营业资质 ›</text>
      </view>
      <view class="mall-addr-row">
        <text class="mall-addr">{{mall.address}}</text>
        <text class="mall-nav" wx:if="{{mall.latitude && mall.longitude}}"
              catchtap="openMallLocation">导航 ›</text>
      </view>
    </view>
  </view>

  <!-- 所有店家并排（横滑可查看全部） -->
  <view class="shops-wrap">
    <scroll-view class="shops-scroll" scroll-x enable-flex scroll-into-view="shop-{{activeShopIndex}}">
      <view class="shop-chip {{activeShopIndex === index ? 'active' : ''}}"
            wx:for="{{shops}}" wx:key="id" id="shop-{{index}}"
            data-index="{{index}}" bindtap="onSelectShop">
        <image class="chip-img" src="{{item.logo}}" mode="aspectFill" />
        <view class="chip-name">{{item.name}}</view>
      </view>
    </scroll-view>
    <view class="shops-all" wx:if="{{shops.length > 5}}">查看全部 ›</view>
  </view>

  <!-- 外送 / 自取 -->
  <view class="mode-bar">
    <view class="mode-item active">外送</view>
    <view class="mode-item">自取<text class="mode-sub" wx:if="{{mall.distance !== null}}">距您 {{mall.distance}}km</text></view>
  </view>

  <!-- 当前档口信息 -->
  <view class="shop-head" wx:if="{{shop}}">
    <view class="shop-head-top">
      <view class="shop-title">{{shop.name}}</view>
      <view class="fav {{favorited ? 'on' : ''}}" bindtap="toggleFavorite">
        <text class="fav-icon">{{favorited ? '♥' : '♡'}}</text>
        <text class="fav-text">{{favorited ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
    <view class="shop-badges">
      <text class="badge-star" bindtap="openComments">★ {{rating}}</text>
      <text class="badge-comment" wx:if="{{commentCount}}" bindtap="openComments">{{commentCount}}条评价 ›</text>
      <text class="badge-shop">食堂店</text>
      <text class="badge-free">免配送费</text>
    </view>
    <view class="shop-meta">起送 ¥{{shop.minOrderAmount}} · 配送 ¥{{shop.deliveryFee}} · 约 {{shop.averageDeliveryTime}} 分钟</view>
  </view>

  <!-- 商品区：左分类 + 右菜品 -->
  <view class="menu">
    <scroll-view class="cate-list" scroll-y>
      <view class="cate-item {{activeCategoryIndex === index ? 'active' : ''}}"
            wx:for="{{categories}}" wx:key="categoryId"
            data-index="{{index}}" bindtap="switchCategory">
        <text class="cate-name">{{item.categoryName}}</text>
      </view>
    </scroll-view>

    <scroll-view class="dish-list" scroll-y>
      <view class="dish-item" wx:for="{{dishes}}" wx:key="id">
        <image class="dish-img" src="{{item.image}}" mode="aspectFill" />
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-hot" wx:if="{{item.hotLabel}}">{{item.hotLabel}}</view>
          <view class="dish-desc" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="dish-bottom">
            <view class="dish-price">
              <text class="price-sign">¥</text>
              <text class="price-num">{{item.price}}</text>
              <text class="price-origin" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
            </view>
            <view class="add-btn spec-btn" wx:if="{{item.specs.length}}" data-dish-id="{{item.id}}" catchtap="addToCart">选规格</view>
            <view class="add-btn" wx:else data-dish-id="{{item.id}}" bindtap="addToCart">+</view>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{!dishes.length}}">该档口暂无在售菜品</view>
      <view class="dish-bottom-space"></view>
    </scroll-view>
  </view>

  <!-- 购物车悬浮条（点击上划查看已选餐品） -->
  <view class="cart-bar">
    <view class="cart-left" bindtap="openCart">
      <view class="cart-icon">🛒<text class="cart-badge" wx:if="{{cartCount}}">{{cartCount}}</text></view>
      <view class="cart-amount" wx:if="{{cartCount}}">¥{{cartTotal}}</view>
      <view class="cart-empty-tip" wx:else>购物车是空的</view>
    </view>
    <view class="cart-submit {{cartCount ? '' : 'disabled'}}" bindtap="goCheckout">去结算</view>
  </view>

  <cart-popup id="cartPopup" visible="{{cartVisible}}" bind:close="closeCart" bind:change="onCartChange" />

  <!-- 顾客评价弹层 -->
  <view class="mask" wx:if="{{commentVisible}}" bindtap="closeComments"></view>
  <view class="comment-panel" wx:if="{{commentVisible}}" catchtap="noop">
    <view class="panel-head">
      <text class="panel-title">顾客评价（{{commentCount}}）</text>
      <text class="panel-close" bindtap="closeComments">✕</text>
    </view>
    <view class="panel-rating" wx:if="{{commentCount}}">
      <text class="panel-score">{{rating}}</text>
      <text class="panel-score-label">综合评分</text>
    </view>
    <scroll-view class="panel-list" scroll-y>
      <view class="comment-item" wx:for="{{comments}}" wx:key="id">
        <view class="comment-head">
          <text class="comment-user">{{item.userName}}</text>
          <text class="comment-stars">{{item.stars}}</text>
        </view>
        <view class="comment-content" wx:if="{{item.content}}">{{item.content}}</view>
        <view class="comment-reply" wx:if="{{item.replyContent}}">
          <view class="comment-reply-text">商家回复：{{item.replyContent}}</view>
          <view class="comment-reply-time">{{item.replyTimeText}}</view>
        </view>
        <view class="comment-time">{{item.createTime}}</view>
      </view>
      <view class="comment-empty" wx:if="{{!comments.length}}">暂无评价</view>
    </scroll-view>
  </view>

  <!-- 规格选择弹层 -->
  <view class="mask" wx:if="{{specVisible}}" bindtap="closeSpec"></view>
  <view class="spec-panel" wx:if="{{specVisible}}" catchtap="noop">
    <view class="spec-head">
      <image class="spec-img" src="{{specDish.image}}" mode="aspectFill" />
      <view class="spec-head-info">
        <view class="spec-name">{{specDish.name}}</view>
        <view class="spec-price">¥{{specUnitPrice}}</view>
      </view>
      <text class="panel-close" bindtap="closeSpec">✕</text>
    </view>
    <view class="spec-section">
      <view class="spec-title">规格</view>
      <view class="spec-options">
        <view class="spec-chip {{specIndex === index ? 'on' : ''}}"
              wx:for="{{specDish.specs}}" wx:key="id" data-index="{{index}}" bindtap="pickSpec">
          <text>{{item.name}}</text>
          <text class="spec-add" wx:if="{{item.price > 0}}">+¥{{item.price}}</text>
        </view>
      </view>
    </view>
    <view class="spec-foot">
      <view class="spec-counter">
        <view class="spec-op" data-delta="-1" bindtap="changeSpecCount">−</view>
        <text class="spec-count">{{specCount}}</text>
        <view class="spec-op plus" data-delta="1" bindtap="changeSpecCount">+</view>
      </view>
      <view class="spec-confirm" bindtap="confirmSpec">加入购物车 ¥{{specTotalPrice}}</view>
    </view>
  </view>
</view>
