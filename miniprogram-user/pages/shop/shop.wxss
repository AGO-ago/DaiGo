page {
  background: #f6f6f6;
}

/* 美食城头部 */
.mall-banner {
  position: relative;
  height: 300rpx;
  background: #ddd;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.65) 100%);
}

.banner-info {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
}

.banner-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ffe6c7;
}

.banner-distance {
  margin-left: 8rpx;
}

.banner-addr,
.banner-hours {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 列表标题 */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 4rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.list-count {
  font-size: 22rpx;
  color: #999;
}

/* 档口卡片 */
.shop-list {
  margin: 0 20rpx;
}

.shop-card {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.shop-logo {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.shop-info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.shop-name-row {
  display: flex;
  align-items: center;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  max-width: 320rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shop-status {
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  font-size: 18rpx;
  border-radius: 6rpx;
}

.shop-status.open {
  color: #18a058;
  background: #e8f8ef;
}

.shop-status.rest {
  color: #999;
  background: #f2f2f2;
}

.shop-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #777;
}

.shop-hours {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #aaa;
}

.shop-enter {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: #ff5a3c;
  border-radius: 24rpx;
}

.empty {
  margin: 80rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.bottom-space {
  height: 40rpx;
}
