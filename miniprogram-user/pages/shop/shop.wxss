.shop-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 20rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
