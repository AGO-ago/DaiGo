page {
  background: #f6f6f6;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 美食城头部 */
.mall-head {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 20rpx 24rpx;
  background: #ffffff;
}

.mall-logo {
  width: 110rpx;
  height: 110rpx;
  border-radius: 16rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.mall-info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.mall-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mall-tags {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.tag {
  margin-right: 10rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #666;
  background: #f4f4f4;
  border-radius: 6rpx;
}

.mall-addr-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.mall-addr {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mall-nav {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #ff5722;
  background: #fff2ef;
  border-radius: 20rpx;
}

/* 店家并排 */
.shops-wrap {
  position: relative;
  flex-shrink: 0;
  background: #ffffff;
  padding: 0 0 16rpx;
}

.shops-scroll {
  height: 180rpx;
  white-space: nowrap;
  display: flex;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.shop-chip {
  flex: 0 0 auto;
  width: 132rpx;
  height: 164rpx;
  margin-right: 14rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  overflow: hidden;
}

.shop-chip.active {
  border-color: #ffb300;
  background: #fffaf0;
}

.chip-img {
  width: 116rpx;
  height: 116rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.chip-name {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #555;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shops-all {
  position: absolute;
  right: 0;
  top: 20rpx;
  padding: 8rpx 6rpx 8rpx 12rpx;
  font-size: 20rpx;
  color: #999;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, #ffffff 30%);
}

/* 外送/自取 */
.mode-bar {
  display: flex;
  flex-shrink: 0;
  margin: 16rpx 20rpx 0;
  background: #ffffff;
  border-radius: 30rpx;
  overflow: hidden;
}

.mode-item {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #777;
}

.mode-item.active {
  color: #ffffff;
  font-weight: 600;
  background: #ff5722;
  border-radius: 30rpx;
}

.mode-sub {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #999;
  font-weight: 400;
}

/* 当前档口信息 */
.shop-head {
  flex-shrink: 0;
  padding: 20rpx 24rpx 16rpx;
  background: #ffffff;
  margin: 16rpx 20rpx 0;
  border-radius: 16rpx;
}

.shop-head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shop-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fav {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: #888;
  border: 1rpx solid #e5e5e5;
  border-radius: 24rpx;
}

.fav.on {
  color: #ff5a3c;
  border-color: #ffd0c6;
  background: #fff5f2;
}

.fav-icon {
  margin-right: 6rpx;
  font-size: 26rpx;
  line-height: 1;
}

.shop-badges {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.badge-star {
  font-size: 22rpx;
  color: #ff6a00;
  margin-right: 14rpx;
}

.badge-comment {
  font-size: 20rpx;
  color: #ff6a00;
  margin-right: 14rpx;
}

.badge-shop {
  font-size: 20rpx;
  color: #18a058;
  background: #e8f8ef;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 14rpx;
}

.badge-free {
  font-size: 20rpx;
  color: #ff5a3c;
  border: 1rpx solid #ffd0c6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.shop-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
}

/* 菜单区 */
.menu {
  flex: 1;
  display: flex;
  margin: 16rpx 20rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  min-height: 0;
}
.cate-list {
  width: 180rpx;
  flex-shrink: 0;
  background: #f7f7f7;
  height: 100%;
}

.cate-item {
  padding: 26rpx 12rpx;
  text-align: center;
}

.cate-item.active {
  background: #ffffff;
  border-left: 6rpx solid #ffb300;
}

.cate-name {
  font-size: 24rpx;
  color: #555;
}

.cate-item.active .cate-name {
  color: #222;
  font-weight: 600;
}

.dish-list {
  flex: 1;
  height: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.dish-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.dish-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.dish-hot {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  color: #c98a00;
  background: #fff6e0;
  border-radius: 6rpx;
}

.dish-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #aaa;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}

.dish-price {
  display: flex;
  align-items: baseline;
}

.price-sign {
  font-size: 22rpx;
  color: #ff2d3c;
}

.price-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff2d3c;
}

.price-origin {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #bbb;
  text-decoration: line-through;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 36rpx;
  color: #ffffff;
  background: #ff5722;
  border-radius: 50%;
}

.dish-bottom-space {
  height: 30rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

/* 购物车悬浮条 */
.cart-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 90rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 24rpx;
  background: #2b2b2b;
  border-radius: 45rpx;
  box-sizing: border-box;
  z-index: 10;
}

.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-icon {
  position: relative;
  font-size: 40rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 18rpx;
  color: #ffffff;
  background: #ff2d3c;
  border-radius: 15rpx;
  padding: 0 4rpx;
}

.cart-amount {
  margin-left: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.cart-empty-tip {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.cart-submit {
  width: 180rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
  border-radius: 35rpx;
}

.cart-submit.disabled {
  background: #4a4a4a;
  color: #999;
}

/* 评价弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.comment-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 101;
  box-sizing: border-box;
  overflow: hidden;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.panel-close {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.panel-rating {
  display: flex;
  align-items: baseline;
  padding: 0 28rpx 16rpx;
}

.panel-score {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff6a00;
}

.panel-score-label {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.panel-list {
  height: 50vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.comment-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #f2f2f2;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-user {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.comment-stars {
  font-size: 22rpx;
  color: #ffb300;
  letter-spacing: 2rpx;
}

.comment-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #444;
  line-height: 1.5;
}

.comment-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #bbb;
}

.comment-reply {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #fff7f2;
  border-radius: 8rpx;
}

.comment-reply-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #d84315;
}

.comment-reply-time {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #bfa89d;
}

.comment-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

/* 规格选择弹层 */
.spec-btn {
  width: auto;
  padding: 0 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.spec-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 101;
  box-sizing: border-box;
}

.spec-head {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.spec-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.spec-head-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.spec-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.spec-price {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ff2d3c;
}

.spec-section {
  padding: 24rpx 28rpx 8rpx;
}

.spec-title {
  font-size: 24rpx;
  color: #999;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.spec-chip {
  display: flex;
  align-items: center;
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #444;
  background: #f5f5f5;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
}

.spec-chip.on {
  color: #ff6a00;
  background: #fff4ec;
  border-color: #ff6a00;
}

.spec-add {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #ff6a00;
}

.spec-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx 24rpx;
}

.spec-counter {
  display: flex;
  align-items: center;
}

.spec-op {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
  background: #f2f2f2;
  border-radius: 50%;
}

.spec-op.plus {
  color: #ffffff;
  background: #ff5722;
}

.spec-count {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #222;
}

.spec-confirm {
  flex: 1;
  margin-left: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: #ff6a00;
  border-radius: 38rpx;
}

