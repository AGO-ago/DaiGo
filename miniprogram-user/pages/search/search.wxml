<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="input-box">
      <image class="input-icon" src="{{icons.search}}" />
      <input class="input" value="{{keyword}}" focus="{{autoFocus}}" confirm-type="search"
             placeholder="搜索店铺、美食" placeholder-class="input-placeholder"
             bindinput="onInput" bindconfirm="doSearch" />
      <text class="clear-btn" wx:if="{{keyword}}" catchtap="clearKeyword">×</text>
    </view>
    <text class="search-btn" bindtap="doSearch">搜索</text>
  </view>

  <!-- 未搜索：历史 + 热门 -->
  <view wx:if="{{!searched}}">
    <view class="block" wx:if="{{history.length}}">
      <view class="block-head">
        <text class="block-title">搜索历史</text>
        <text class="block-clear" bindtap="clearHistory">清空</text>
      </view>
      <view class="tags">
        <text class="tag" wx:for="{{history}}" wx:key="*this"
              data-keyword="{{item}}" bindtap="tapKeyword">{{item}}</text>
      </view>
    </view>

    <view class="block">
      <view class="block-head">
        <text class="block-title">热门搜索</text>
      </view>
      <view class="tags">
        <text class="tag hot" wx:for="{{hotWords}}" wx:key="*this"
              data-keyword="{{item}}" bindtap="tapKeyword">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view wx:else>
    <!-- 档口 -->
    <view class="block" wx:if="{{shops.length}}">
      <view class="block-head">
        <text class="block-title">档口</text>
        <text class="block-count">{{shops.length}} 个结果</text>
      </view>
      <view class="shop-item" wx:for="{{shops}}" wx:key="id"
            data-mall-id="{{item.mallId}}" data-shop-id="{{item.id}}"
            data-shop-name="{{item.name}}" bindtap="goShop">
        <image class="shop-logo" src="{{item.logo}}" mode="aspectFill" />
        <view class="shop-info">
          <view class="shop-name">{{item.name}}</view>
          <view class="shop-meta" wx:if="{{item.mallName}}">{{item.mallName}}</view>
          <view class="shop-tags">
            <text class="mini-tag">起送 ¥{{item.minOrderAmount}}</text>
            <text class="mini-tag">配送 ¥{{item.deliveryFee}}</text>
            <text class="mini-tag" wx:if="{{item.distance !== null}}">{{item.distance}}km</text>
          </view>
        </view>
        <text class="shop-enter">进店 ›</text>
      </view>
    </view>

    <!-- 菜品 -->
    <view class="block" wx:if="{{dishes.length}}">
      <view class="block-head">
        <text class="block-title">美食</text>
        <text class="block-count">{{dishes.length}} 个结果</text>
      </view>
      <view class="dish-item" wx:for="{{dishes}}" wx:key="id">
        <image class="dish-img" src="{{item.image}}" mode="aspectFill"
               data-mall-id="{{item.mallId}}" data-shop-id="{{item.shopId}}"
               data-shop-name="{{item.shopName}}" bindtap="goShop" />
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-shop" data-mall-id="{{item.mallId}}" data-shop-id="{{item.shopId}}"
                data-shop-name="{{item.shopName}}" bindtap="goShop">{{item.shopName}} ›</view>
          <view class="dish-bottom">
            <view class="dish-price">
              <text class="price-sign">¥</text>
              <text class="price-num">{{item.price}}</text>
              <text class="price-origin" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
            </view>
            <view class="add-btn" data-index="{{index}}" catchtap="addDish">+</view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !shops.length && !dishes.length}}">
      没有找到「{{keyword}}」相关结果
    </view>
    <view class="bottom-space"></view>
  </view>

  <!-- 悬浮购物车 -->
  <view class="cart-fab" wx:if="{{cartCount}}" bindtap="openCart">
    <image class="fab-icon" src="{{icons.cartWhite}}" />
    <text class="fab-badge">{{cartCount}}</text>
  </view>

  <cart-popup visible="{{cartVisible}}" bind:close="closeCart" bind:change="onCartChange" />
</view>
