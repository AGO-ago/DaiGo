page {
  background: #f6f6f6;
}

.page {
  padding: 20rpx 24rpx;
}

.shop {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 22rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mall {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.tags {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.tag {
  margin-right: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #ff5a3c;
  background: #fff2ef;
  border-radius: 6rpx;
}

.ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.enter {
  font-size: 24rpx;
  color: #999;
}

.remove {
  margin-top: 22rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #999;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
}

.empty {
  margin: 160rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.bottom-space {
  height: 40rpx;
}
