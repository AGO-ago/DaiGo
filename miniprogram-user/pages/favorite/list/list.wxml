<view class="page">
  <view class="shop" wx:for="{{list}}" wx:key="id"
        data-mall-id="{{item.mallId}}" data-shop-id="{{item.id}}"
        data-shop-name="{{item.name}}" bindtap="goShop">
    <image class="logo" src="{{item.logo}}" mode="aspectFill" />
    <view class="info">
      <view class="name">{{item.name}}</view>
      <view class="mall" wx:if="{{item.mallName}}">{{item.mallName}}</view>
      <view class="tags">
        <text class="tag">起送 ¥{{item.minOrderAmount}}</text>
        <text class="tag">配送 ¥{{item.deliveryFee}}</text>
        <text class="tag" wx:if="{{item.distance !== null}}">{{item.distance}}km</text>
      </view>
    </view>
    <view class="ops">
      <text class="enter">进店 ›</text>
      <text class="remove" data-id="{{item.id}}" catchtap="remove">取消收藏</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">还没有收藏的档口，去逛逛吧</view>
  <view class="bottom-space"></view>
</view>
