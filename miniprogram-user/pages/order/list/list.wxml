<view class="page">
  <view class="tabs">
    <view class="tab {{currentStatus === item.key ? 'active' : ''}}" wx:for="{{statusTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchStatus">{{item.label}}</view>
  </view>

  <view class="order" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="order-head">
      <text class="shop-name">{{item.shopName}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="summary">{{item.summary}}</view>
    <view class="order-foot">
      <text class="time">{{item.createTime}}</text>
      <view class="foot-right">
        <text class="amount">实付 ¥{{item.payAmount}}</text>
        <text class="again" wx:if="{{item.status === 4}}" data-index="{{index}}" catchtap="repeatOrder">再来一单</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !orders.length}}">暂无订单</view>
</view>
