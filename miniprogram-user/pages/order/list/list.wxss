page {
  background: #f6f6f6;
}

.page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  color: #ff5722;
  font-weight: 600;
  border-bottom: 4rpx solid #ff5722;
}

.order {
  background: #fff;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.status {
  font-size: 24rpx;
  color: #ff5722;
}

.summary {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #777;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.time {
  font-size: 22rpx;
  color: #aaa;
}

.amount {
  font-size: 26rpx;
  color: #333;
}

.empty {
  margin: 120rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
