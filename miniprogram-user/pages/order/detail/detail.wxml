<view class="page" wx:if="{{order}}">
  <view class="status-card">
    <view class="status-text">{{statusText}}</view>
    <view class="status-tip" wx:if="{{order.status === 0}}">请尽快完成支付，超时订单将自动取消</view>
    <view class="status-tip" wx:if="{{order.status === 6}}">退款申请已提交，等待商家处理</view>
    <view class="status-tip" wx:if="{{order.status === 7}}">退款已完成，款项将原路退回</view>
  </view>

  <view class="card">
    <view class="shop-name">{{order.shopName}}</view>
    <view class="item" wx:for="{{order.items}}" wx:key="index">
      <image class="item-img" src="{{item.dishImage}}" mode="aspectFill" />
      <view class="item-info">
        <view class="item-name">{{item.dishName}}</view>
        <view class="item-spec" wx:if="{{item.specName}}">{{item.specName}}</view>
        <view class="item-price">¥{{item.price}} × {{item.count}}</view>
      </view>
      <view class="item-amount">¥{{item.amount}}</view>
    </view>
    <view class="total-row">
      <text>商品小计</text>
      <text>¥{{order.totalAmount}}</text>
    </view>
    <view class="total-row">
      <text>配送费</text>
      <text>¥{{order.deliveryFee}}</text>
    </view>
    <view class="total-row strong">
      <text>实付</text>
      <text class="pay">¥{{order.payAmount}}</text>
    </view>
  </view>

  <view class="card">
    <view class="label">收货信息</view>
    <view class="value">{{order.addressSnapshot}}</view>
    <view class="label" wx:if="{{order.remark}}">备注</view>
    <view class="value" wx:if="{{order.remark}}">{{order.remark}}</view>
    <view class="label">订单号</view>
    <view class="value">{{order.orderNo}}</view>
    <view class="label">下单时间</view>
    <view class="value">{{order.createTime}}</view>
  </view>

  <view class="actions" wx:if="{{order.status === 0}}">
    <view class="btn ghost" bindtap="cancel">取消订单</view>
    <view class="btn primary" bindtap="pay">立即支付</view>
  </view>

  <view class="actions" wx:elif="{{order.status === 1 || order.status === 2}}">
    <view class="btn ghost" bindtap="applyRefund">申请退款</view>
  </view>

  <view class="actions" wx:elif="{{order.status === 4}}">
    <view class="btn ghost" bindtap="repeatOrder">再来一单</view>
    <view class="btn primary" wx:if="{{!order.commented}}" bindtap="goComment">去评价</view>
    <view class="btn ghost" wx:else>已评价</view>
  </view>

  <view class="bottom-space"></view>
</view>
