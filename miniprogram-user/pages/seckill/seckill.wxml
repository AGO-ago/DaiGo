<view class="page">
  <!-- 活动头部 -->
  <view class="hero">
    <view class="hero-left">
      <view class="hero-title">品质外卖专属补贴</view>
      <view class="hero-sub">限时限量抢购</view>
    </view>
    <image class="hero-img"
           src="https://console.enterprise.trae.cn/api/ide/v1/text_to_image?prompt=cartoon%20delivery%20courier%20holding%20bubble%20tea%20orange%20jacket%20smiling&image_size=square"
           mode="aspectFit" />
  </view>

  <!-- 倒计时 -->
  <view class="countdown">
    <view class="cd-left">
      <text class="cd-label">正在秒杀</text>
      <text class="cd-time">{{countdown}}</text>
    </view>
  </view>

  <!-- 秒杀列表 -->
  <view class="list">
    <view class="card" wx:for="{{dishes}}" wx:key="id">
      <view class="card-main">
        <image class="thumb" src="{{item.image}}" mode="aspectFill" />
        <view class="info">
          <view class="name">{{item.name}}</view>
          <view class="shop-row" data-shop-id="{{item.shopId}}" data-mall-id="{{item.mallId}}"
                data-shop-name="{{item.shopName}}" bindtap="goShop">
            <text class="shop-name">{{item.shopName}}</text>
            <text class="shop-arrow">›</text>
          </view>
          <view class="tags">
            <text class="tag-star">★ 5.0</text>
            <text class="tag">免配送费</text>
            <text class="tag" wx:if="{{item.distance !== null}}">{{item.distance}}km</text>
          </view>
        </view>
      </view>
      <view class="price-row">
        <view class="price-left">
          <text class="seckill-label">秒杀价</text>
          <text class="price-sign">¥</text>
          <text class="price-num">{{item.price}}</text>
          <text class="price-origin" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
        </view>
        <view class="grab-btn" data-index="{{index}}" bindtap="grab">抢</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !dishes.length}}">暂无秒杀商品</view>
  </view>

  <view class="cart-fab" bindtap="openCart">
    <image class="cart-fab-icon" src="{{icons.cartWhite}}" />
    <text class="cart-fab-badge" wx:if="{{cartCount}}">{{cartCount}}</text>
  </view>
  <view class="bottom-space"></view>

  <cart-popup visible="{{cartVisible}}" bind:close="closeCart" bind:change="onCartChange" />
</view>
