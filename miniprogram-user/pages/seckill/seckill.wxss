page {
  background: #f6f6f6;
}

.page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 活动头部 */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 46rpx;
  background: linear-gradient(135deg, #ff5f3b 0%, #ff3b2f 100%);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  font-style: italic;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  font-style: italic;
  opacity: 0.95;
}

.hero-img {
  width: 160rpx;
  height: 160rpx;
  margin: -20rpx 0;
}

/* 倒计时 */
.countdown {
  position: relative;
  margin-top: -26rpx;
  padding: 0 24rpx;
}

.cd-left {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 40rpx 12rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx 20rpx 20rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.cd-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff3b2f;
  margin-right: 14rpx;
}

.cd-time {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff3b2f;
  letter-spacing: 2rpx;
}

/* 列表 */
.list {
  padding: 20rpx 24rpx 0;
}

.card {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 18rpx;
}

.card-main {
  display: flex;
}

.thumb {
  width: 200rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.shop-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.shop-name {
  font-size: 22rpx;
  color: #999;
  max-width: 280rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shop-arrow {
  font-size: 22rpx;
  color: #bbb;
  margin-left: 4rpx;
}

.tags {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 10rpx;
}

.tag-star {
  font-size: 22rpx;
  color: #ff8a00;
  margin-right: 14rpx;
}

.tag {
  margin-right: 14rpx;
  padding: 2rpx 8rpx;
  font-size: 20rpx;
  color: #ff5a3c;
  background: #fff2ef;
  border-radius: 6rpx;
}

/* 价格行 */
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.price-left {
  display: flex;
  align-items: baseline;
  padding: 6rpx 14rpx;
  background: #fff2ef;
  border-radius: 8rpx;
}

.seckill-label {
  font-size: 22rpx;
  color: #ff3b2f;
  margin-right: 8rpx;
}

.price-sign {
  font-size: 22rpx;
  color: #ff2d3c;
}

.price-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff2d3c;
}

.price-origin {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #b0b0b0;
  text-decoration: line-through;
}

.grab-btn {
  width: 110rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  font-style: italic;
  background: linear-gradient(135deg, #ff7a45 0%, #ff2d3c 100%);
  border-radius: 10rpx 10rpx 10rpx 24rpx;
}

.empty {
  margin: 120rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 悬浮购物车 */
.cart-fab {
  position: fixed;
  right: 30rpx;
  bottom: calc(50rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2b2b2b;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
  z-index: 20;
}

.cart-fab-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  color: #ffffff;
  background: #ff2d2d;
  border-radius: 17rpx;
}

.cart-fab-icon {
  width: 48rpx;
  height: 48rpx;
}

.bottom-space {
  height: 40rpx;
}
