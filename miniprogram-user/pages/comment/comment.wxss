page {
  background: #f6f6f6;
}

.page {
  padding: 20rpx 24rpx;
}

.card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.shop {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.stars {
  display: flex;
  margin-top: 20rpx;
}

.star {
  margin-right: 18rpx;
  font-size: 56rpx;
  line-height: 1;
  color: #e5e5e5;
}

.star.on {
  color: #ffb300;
}

.score-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff8a00;
}

.textarea {
  width: 100%;
  height: 220rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.placeholder {
  color: #b5b5b5;
  font-size: 26rpx;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
}

.submit {
  margin-top: 30rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  color: #ffffff;
  background: #ff5a3c;
  border-radius: 42rpx;
}

.submit.disabled {
  opacity: 0.6;
}
