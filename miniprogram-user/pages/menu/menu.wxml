<view class="page">
  <scroll-view class="catalog" scroll-y>
    <view class="cat {{activeIndex === index ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this" wx:for-index="index" bindtap="switchCategory" data-index="{{index}}">{{item}}</view>
  </scroll-view>

  <scroll-view class="list" scroll-y>
    <view class="dish" wx:for="{{dishes}}" wx:key="id">
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view class="desc">{{item.description}}</view>
        <view class="price">¥{{item.price}}</view>
      </view>
      <view class="add" data-dish-id="{{item.id}}" data-name="{{item.name}}" data-price="{{item.price}}" bindtap="addToCart">＋</view>
    </view>
    <view class="empty" wx:if="{{!loading && !dishes.length}}">该档口暂无菜品</view>
  </scroll-view>
</view>
