<view class="page">
  <!-- 收货地址 -->
  <view class="card address-card" bindtap="chooseAddress">
    <block wx:if="{{address}}">
      <view class="addr-main">
        <image class="addr-icon" src="{{icons.location}}" />
        <view class="addr-info">
          <view class="addr-title">{{address.company}} {{address.building}}{{address.floor}}{{address.office}}</view>
          <view class="addr-sub">{{address.contact}} {{address.phone}}</view>
        </view>
        <image class="arrow" src="{{icons.chevron}}" />
      </view>
    </block>
    <view class="addr-empty" wx:else>
      <text>请选择收货地址</text>
      <image class="arrow" src="{{icons.chevron}}" />
    </view>
  </view>

  <!-- 优惠券 -->
  <view class="card coupon-card" bindtap="openCoupon">
    <view class="coupon-row">
      <view class="coupon-label">
        <image class="coupon-icon" src="{{icons.coupon}}" />
        <text>优惠券</text>
      </view>
      <view class="coupon-value">
        <text class="coupon-on" wx:if="{{selectedCouponId}}">
          -¥{{preview.discountAmount}}
          <text class="coupon-tag">{{selectedCouponName}}</text>
        </text>
        <text class="coupon-count" wx:elif="{{couponUsableCount > 0}}">{{couponUsableCount}} 张可用</text>
        <text class="coupon-none" wx:else>暂无可用</text>
        <image class="arrow" src="{{icons.chevron}}" />
      </view>
    </view>
  </view>

  <!-- 拆单预览 -->
  <view class="card" wx:for="{{preview.groups}}" wx:key="shopId">
    <view class="group-head">
      <text class="shop-name">{{item.shopName}}</text>
      <text class="delivery-time">约 {{item.averageDeliveryTime}} 分钟</text>
    </view>
    <view class="item" wx:for="{{item.items}}" wx:for-item="dish" wx:key="index">
      <image class="thumb" src="{{dish.dishImage}}" mode="aspectFill" />
      <view class="item-info">
        <view class="item-name">{{dish.dishName}}</view>
        <view class="item-spec" wx:if="{{dish.specName}}">{{dish.specName}}</view>
        <view class="item-count">× {{dish.quantity}}</view>
      </view>
      <view class="item-amount">¥{{dish.amount}}</view>
    </view>
    <view class="row">
      <text>商品小计</text>
      <text>¥{{item.totalAmount}}</text>
    </view>
    <view class="row">
      <text>配送费</text>
      <text>¥{{item.deliveryFee}}</text>
    </view>
    <view class="row discount" wx:if="{{item.discountAmount > 0}}">
      <text>优惠</text>
      <text>-¥{{item.discountAmount}}</text>
    </view>
    <view class="row strong">
      <text>本单实付</text>
      <text class="pay">¥{{item.payAmount}}</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card">
    <view class="remark-row">
      <text class="remark-label">备注</text>
      <input class="remark-input" placeholder="口味、餐具等要求" maxlength="200"
             value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !preview}}">购物车为空或暂无可结算商品</view>

  <!-- 底部提交 -->
  <view class="footer">
    <view class="total">
      <view class="total-line" wx:if="{{preview && preview.discountAmount > 0}}">
        <text class="discount-tip">已优惠 ¥{{preview.discountAmount}}</text>
      </view>
      <text class="label">合计</text>
      <text class="amount">¥{{preview ? preview.totalAmount : '0.00'}}</text>
    </view>
    <view class="submit {{submitting ? 'disabled' : ''}}" bindtap="submit">提交订单</view>
  </view>

  <!-- 优惠券选择弹层 -->
  <view class="mask" wx:if="{{couponVisible}}" bindtap="closeCoupon"></view>
  <view class="coupon-panel" wx:if="{{couponVisible}}" catchtap="noop">
    <view class="panel-head">
      <text class="panel-title">选择优惠券</text>
      <text class="panel-close" bindtap="closeCoupon">✕</text>
    </view>
    <scroll-view class="panel-list" scroll-y>
      <view class="pick-item {{item.usable ? '' : 'off'}} {{item.selected ? 'on' : ''}}"
            wx:for="{{coupons}}" wx:key="id" data-id="{{item.id}}" bindtap="pickCoupon">
        <view class="pick-left">
          <view class="pick-amount">{{item.amountText}}</view>
          <view class="pick-threshold">满{{item.threshold}}元可用</view>
        </view>
        <view class="pick-right">
          <view class="pick-name">{{item.name}}</view>
          <view class="pick-scope">{{item.shopName}}</view>
          <view class="pick-reason" wx:if="{{!item.usable}}">{{item.reason}}</view>
        </view>
        <view class="pick-check" wx:if="{{item.selected}}">✓</view>
      </view>
      <view class="pick-none" bindtap="clearCoupon">不使用优惠券</view>
    </scroll-view>
  </view>
</view>
