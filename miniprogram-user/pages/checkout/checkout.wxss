page {
  background: #f6f6f6;
}

.page {
  padding: 20rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.address-card {
  padding: 28rpx 24rpx;
}

.addr-main {
  display: flex;
  align-items: center;
}

.addr-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.addr-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.addr-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.addr-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.addr-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #ff5a3c;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.shop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.delivery-time {
  font-size: 22rpx;
  color: #999;
}

.item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.item-name {
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-count {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.item-amount {
  font-size: 26rpx;
  color: #333;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.row.strong {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
}

.pay {
  color: #ff2d3c;
}

.remark-row {
  display: flex;
  align-items: center;
}

.remark-label {
  font-size: 26rpx;
  color: #333;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.remark-input {
  flex: 1;
  font-size: 26rpx;
}

.empty {
  margin: 100rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.total {
  flex: 1;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff2d3c;
}

.submit {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  background: #ffd54f;
  border-radius: 38rpx;
}

.submit.disabled {
  opacity: 0.6;
}

/* 优惠券入口 */
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coupon-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333;
}

.coupon-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
}

.coupon-value {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.coupon-on {
  color: #ff2d3c;
  font-weight: 600;
}

.coupon-tag {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #ff5722;
  background: #fff3ee;
  border-radius: 6rpx;
}

.coupon-count {
  color: #ff5722;
}

.coupon-none {
  color: #999;
}

.row.discount {
  color: #ff2d3c;
}

.total-line {
  margin-bottom: 4rpx;
}

.discount-tip {
  font-size: 22rpx;
  color: #ff5722;
}

/* 优惠券选择弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.5);
}

.coupon-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
  padding-bottom: env(safe-area-inset-bottom);
  background: #f6f6f6;
  border-radius: 24rpx 24rpx 0 0;
}

.panel-head {
  position: relative;
  padding: 30rpx 0;
  text-align: center;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.panel-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  font-size: 30rpx;
  color: #999;
}

.panel-list {
  height: 50vh;
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.pick-item {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 24rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
}

.pick-item.on {
  border-color: #ff5722;
  background: #fff8f5;
}

.pick-item.off .pick-amount,
.pick-item.off .pick-name {
  color: #bbb;
}

.pick-left {
  width: 160rpx;
  text-align: center;
  flex-shrink: 0;
  border-right: 1rpx dashed #eee;
}

.pick-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff2d3c;
}

.pick-threshold {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
}

.pick-right {
  flex: 1;
  padding-left: 20rpx;
  min-width: 0;
}

.pick-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
}

.pick-scope {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.pick-reason {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #ff9800;
}

.pick-check {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 30rpx;
  color: #ff5722;
}

.pick-none {
  padding: 26rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  background: #ffffff;
  border-radius: 14rpx;
}

