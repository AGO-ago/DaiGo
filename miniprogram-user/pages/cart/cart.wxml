<view class="page">
  <view class="group" wx:for="{{groups}}" wx:key="shopId">
    <view class="group-head">
      <text class="shop-name">{{item.shopName}}</text>
      <text class="group-tag">拆单</text>
    </view>
    <view class="item" wx:for="{{item.items}}" wx:for-item="dish" wx:key="dishId">
      <image class="thumb" src="{{dish.image}}" mode="aspectFill" />
      <view class="info">
        <view class="name">{{dish.name}}</view>
        <view class="price">¥{{dish.price}}</view>
      </view>
      <view class="ops">
        <view class="op" data-index="{{dish.index}}" data-delta="-1" bindtap="changeCount">−</view>
        <text class="count">{{dish.count}}</text>
        <view class="op plus" data-index="{{dish.index}}" data-delta="1" bindtap="changeCount">+</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!groups.length}}">
    <view>购物车还是空的</view>
    <view class="go-shop" bindtap="goShop">去逛逛</view>
  </view>

  <view class="tip" wx:if="{{groups.length}}">不同档口的商品将自动拆分为多笔子订单，一次支付即可</view>

  <view class="footer" wx:if="{{groups.length}}">
    <view class="clear" bindtap="clear">清空</view>
    <view class="footer-total">
      <text class="label">合计</text>
      <text class="amount">¥{{total}}</text>
    </view>
    <view class="submit" bindtap="goCheckout">去结算（{{count}}）</view>
  </view>
</view>
