page {
  background: #f6f6f6;
}

.page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff5722 100%);
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 52rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  flex-shrink: 0;
}

.bind-card {
  margin-top: 20rpx;
}

.bind-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.bind-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.phone-auth {
  margin-top: 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #ff5722;
  border-radius: 38rpx;
}

.bind-dev-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #ff5722;
}

.bind-dev {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.phone-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 36rpx;
}

.phone-save {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #ff5722;
  border-radius: 36rpx;
}

.profile-info {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a3200;
}

.sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(74, 50, 0, 0.65);
}

.logout {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #4a3200;
  border: 1rpx solid rgba(74, 50, 0, 0.35);
  border-radius: 30rpx;
}

.login-btn {
  padding: 12rpx 34rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: #4a3200;
  border-radius: 30rpx;
}

.card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.all {
  font-size: 22rpx;
  color: #999;
}

.order-entries {
  display: flex;
  margin-top: 24rpx;
}

.entry {
  flex: 1;
  text-align: center;
}

.entry-icon {
  font-size: 40rpx;
}

.entry-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #555;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
}

.menu-label {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #333;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
}

.version {
  margin-top: 60rpx;
  text-align: center;
  font-size: 20rpx;
  color: #c0c0c0;
}
