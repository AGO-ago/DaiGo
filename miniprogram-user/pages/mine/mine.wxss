.header {
  background: #fff;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.name {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.logout {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}

.login-btn {
  background: #ff5722;
  color: #fff;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
}

.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}
