<view class="page">
  <!-- 用户信息 -->
  <view class="profile">
    <image class="avatar" wx:if="{{user && user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
    <view class="avatar" wx:else>🍜</view>
    <block wx:if="{{user}}">
      <view class="profile-info">
        <view class="nickname">{{user.nickname || '微信用户'}}</view>
        <view class="sub">{{user.phone || '未绑定手机号'}} · ID: {{user.userId}}</view>
      </view>
      <view class="logout" bindtap="onLogout">退出</view>
    </block>
    <block wx:else>
      <view class="profile-info">
        <view class="nickname">未登录</view>
        <view class="sub">登录后可下单、查看订单</view>
      </view>
      <view class="login-btn" bindtap="onLogin">登录</view>
    </block>
  </view>

  <!-- 手机号绑定 -->
  <view class="card bind-card" wx:if="{{user && !user.phone}}">
    <view class="bind-title">绑定手机号</view>
    <view class="bind-tip">用于下单、接收取餐通知与账号找回</view>
    <button class="phone-auth" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">微信一键绑定</button>
    <view class="bind-dev" wx:if="{{showPhoneInput}}">
      <input class="phone-input" type="number" maxlength="11" placeholder="输入手机号" value="{{phoneInput}}" bindinput="onPhoneInput" />
      <view class="phone-save" bindtap="onSavePhone">保存</view>
    </view>
    <view class="bind-dev-link" wx:else bindtap="togglePhoneInput">本地联调：手动填写手机号</view>
  </view>

  <!-- 我的订单 -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">我的订单</text>
      <view class="all" data-status="" bindtap="goOrders">全部订单 ›</view>
    </view>
    <view class="order-entries">
      <view class="entry" wx:for="{{orderEntries}}" wx:key="key"
            data-status="{{item.key}}" bindtap="goOrders">
        <view class="entry-icon">{{item.icon}}</view>
        <view class="entry-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="card">
    <view class="menu-row" bindtap="goCoupon">
      <image class="menu-icon" src="{{icons.coupon}}" />
      <text class="menu-label">我的优惠券</text>
      <image class="menu-arrow" src="{{icons.chevron}}" />
    </view>
    <view class="menu-row" bindtap="goCouponCenter">
      <image class="menu-icon" src="{{icons.gift}}" />
      <text class="menu-label">领券中心</text>
      <image class="menu-arrow" src="{{icons.chevron}}" />
    </view>
    <view class="menu-row" bindtap="goFavorite">
      <image class="menu-icon" src="{{icons.star}}" />
      <text class="menu-label">我的收藏</text>
      <image class="menu-arrow" src="{{icons.chevron}}" />
    </view>
    <view class="menu-row" bindtap="goAddress">
      <image class="menu-icon" src="{{icons.address}}" />
      <text class="menu-label">收货地址</text>
      <image class="menu-arrow" src="{{icons.chevron}}" />
    </view>
    <view class="menu-row" bindtap="contactService">
      <image class="menu-icon" src="{{icons.service}}" />
      <text class="menu-label">联系客服</text>
      <image class="menu-arrow" src="{{icons.chevron}}" />
    </view>
  </view>

  <view class="version">代go · 校园美食城 v1.0.0</view>
</view>
