page {
  background: #f6f6f6;
}

.banner {
  position: relative;
  padding: 36rpx 32rpx 44rpx;
  background: linear-gradient(135deg, #ff7043, #ff3b30);
  border-radius: 0 0 24rpx 24rpx;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mine-entry {
  position: absolute;
  right: 28rpx;
  top: 44rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
}

.list {
  padding: 24rpx;
}

.coupon {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 26rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.left {
  width: 170rpx;
  text-align: center;
  flex-shrink: 0;
}

.amount {
  font-size: 26rpx;
  font-weight: 700;
  color: #ff3b30;
  line-height: 1;
}

.amount .num {
  font-size: 56rpx;
}

.threshold {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #999;
}

.split {
  width: 1rpx;
  height: 90rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.right {
  flex: 1;
  padding: 0 20rpx;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.scope {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
}

.btn {
  flex-shrink: 0;
  padding: 0 26rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7043, #ff3b30);
  border-radius: 28rpx;
}

.btn.done {
  color: #999;
  background: #f2f2f2;
}

.coupon.received .amount,
.coupon.received .name {
  color: #aaa;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
