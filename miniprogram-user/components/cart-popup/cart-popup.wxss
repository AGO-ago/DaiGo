.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s;
  z-index: 90;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  z-index: 91;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel.show {
  transform: translateY(0);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.clear {
  font-size: 24rpx;
  color: #999;
}

.list {
  height: 46vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.group-name {
  padding: 20rpx 0 10rpx;
  font-size: 24rpx;
  color: #888;
}

.row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.name {
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.price {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ff2d3c;
}

.spec {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

.ops {
  display: flex;
  align-items: center;
}

.op {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  border: 1rpx solid #e5e5e5;
  border-radius: 50%;
  box-sizing: border-box;
}

.op.plus {
  color: #ffffff;
  background: #38a3ff;
  border-color: #38a3ff;
}

.num {
  width: 60rpx;
  text-align: center;
  font-size: 26rpx;
}

.empty {
  margin: 100rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.panel-foot {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f5f5f5;
}

.total {
  flex: 1;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff2d3c;
}

.checkout {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 46rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  background: #ffd54f;
  border-radius: 38rpx;
}

.checkout.disabled {
  opacity: 0.5;
}
