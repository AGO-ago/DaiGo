page {
  background: #f5f5f5;
}

.summary {
  margin: 24rpx;
  padding: 36rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 16rpx;
}

.score {
  font-size: 62rpx;
  font-weight: 700;
  color: #ff8a00;
}

.score-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.comment {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.stars {
  font-size: 24rpx;
  color: #ffb300;
  letter-spacing: 2rpx;
}

.content {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #444;
}

.time {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
