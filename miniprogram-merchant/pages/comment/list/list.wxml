<view class="page">
  <view class="summary" wx:if="{{list.length}}">
    <view class="score">{{avgScore}}</view>
    <view class="score-label">综合评分 · 共 {{list.length}} 条评价</view>
  </view>

  <view class="comment" wx:for="{{list}}" wx:key="id">
    <view class="comment-head">
      <text class="user">{{item.userName}}</text>
      <text class="stars">{{item.stars}}</text>
    </view>
    <view class="content" wx:if="{{item.content}}">{{item.content}}</view>
    <view class="time">{{item.createTime}}</view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">暂无评价</view>
</view>
