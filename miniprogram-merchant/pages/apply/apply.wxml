<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:else>
    <view class="status-card approved" wx:if="{{shop}}">
      <view class="status-title">已入驻</view>
      <view class="status-desc">当前账号已绑定档口「{{shop.name}}」，可直接经营。</view>
      <view class="status-btn" bindtap="goShop">进入档口设置</view>
    </view>

    <block wx:else>
      <view class="status-card {{apply.status === 0 ? 'pending' : (apply.status === 2 ? 'rejected' : 'approved')}}"
            wx:if="{{apply}}">
        <view class="status-title">
          {{apply.status === 0 ? '审核中' : (apply.status === 2 ? '已驳回' : '已通过')}}
        </view>
        <view class="status-desc">
          <block wx:if="{{apply.status === 0}}">申请已提交，平台审核通常在 1 个工作日内完成。</block>
          <block wx:elif="{{apply.status === 2}}">驳回原因：{{apply.rejectReason || '未填写'}}，修改后可重新提交。</block>
          <block wx:else>审核已通过，请重新进入页面查看档口。</block>
        </view>
        <view class="status-meta">申请档口：{{apply.shopName}}</view>
        <view class="status-meta" wx:if="{{apply.mallName}}">所属美食城：{{apply.mallName}}</view>
        <view class="status-meta">提交时间：{{apply.createTime}}</view>
      </view>

      <view class="form-card" wx:if="{{!apply || apply.status === 2}}">
        <view class="form-title">提交入驻申请</view>

        <view class="form-row">
          <text class="form-label">档口名称</text>
          <input class="form-input" value="{{form.shopName}}" data-field="shopName" bindinput="onInput"
                 placeholder="请输入档口名称" maxlength="64" />
        </view>

        <view class="form-row" bindtap="chooseMall">
          <text class="form-label">所属美食城</text>
          <view class="form-input picker-value {{form.mallId ? '' : 'placeholder'}}">
            {{mallName || '请选择美食城'}}
          </view>
          <text class="arrow">›</text>
        </view>

        <view class="form-row">
          <text class="form-label">联系人</text>
          <input class="form-input" value="{{form.contact}}" data-field="contact" bindinput="onInput"
                 placeholder="请输入联系人姓名" maxlength="32" />
        </view>

        <view class="form-row">
          <text class="form-label">手机号</text>
          <input class="form-input" value="{{form.phone}}" data-field="phone" bindinput="onInput"
                 type="number" placeholder="请输入 11 位手机号" maxlength="11" />
        </view>

        <view class="form-row">
          <text class="form-label">营业时间</text>
          <input class="form-input" value="{{form.businessHours}}" data-field="businessHours" bindinput="onInput"
                 placeholder="如 09:00-21:00" maxlength="64" />
        </view>

        <view class="form-row license-row">
          <text class="form-label">营业执照</text>
          <view class="license-box" bindtap="chooseLicense">
            <block wx:if="{{form.licenseImg}}">
              <image class="license-img" src="{{licensePreview}}" mode="aspectFill" />
            </block>
            <block wx:else>
              <text class="license-plus">{{uploading ? '上传中...' : '+'}}</text>
              <text class="license-tip">点击上传</text>
            </block>
          </view>
        </view>

        <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
          {{submitting ? '提交中...' : '提交申请'}}
        </view>
        <view class="form-tip">提交后由平台审核，通过后自动绑定档口并开通经营权限。</view>
      </view>
    </block>
  </block>
</view>
