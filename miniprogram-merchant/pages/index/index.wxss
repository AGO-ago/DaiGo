page {
  background: #f5f5f5;
}

.page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 品牌栏 */
.brand-bar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
}

.brand-mark {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #ff5722;
  background: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(180, 50, 0, 0.22);
}

.brand-name {
  margin-left: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
  font-style: italic;
  letter-spacing: 2rpx;
  color: #ffffff;
  text-shadow: 0 4rpx 10rpx rgba(150, 40, 0, 0.25);
}

.brand-en {
  font-size: 40rpx;
  color: #ffe9a8;
}

.brand-slogan {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.88);
}

.login-card {
  margin: 80rpx 48rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 24rpx;
}

.login-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.login-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.login-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 20rpx 64rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
  border-radius: 40rpx;
}

.shop-head {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
}

.shop-head-main {
  flex: 1;
  min-width: 0;
}

.shop-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.shop-hours {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.biz-toggle {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: #ff5722;
  background: #ffffff;
  border-radius: 30rpx;
}

.biz-toggle.on {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.24);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.stat {
  display: flex;
  margin: -20rpx 24rpx 0;
  padding: 30rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.num {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
}

.num.highlight {
  color: #ff2d3c;
}

.label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.section {
  margin: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.order {
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.order-head {
  display: flex;
  justify-content: space-between;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff2d3c;
}

.order-dishes {
  margin-top: 10rpx;
}

.dish-line {
  display: inline-block;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #333;
}

.order-addr {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.order-remark {
  flex: 1;
  font-size: 22rpx;
  color: #ff9800;
  margin-right: 16rpx;
}

.accept-btn {
  flex-shrink: 0;
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
  border-radius: 30rpx;
}
