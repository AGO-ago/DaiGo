<view class="page">
  <view class="stat card">
    <view class="stat-item">
      <view class="num">{{stat.todayAmount || 0}}</view>
      <view class="label">今日营收(元)</view>
    </view>
    <view class="stat-item">
      <view class="num">{{stat.todayOrderCount || 0}}</view>
      <view class="label">今日订单</view>
    </view>
    <view class="stat-item" bindtap="goOrders">
      <view class="num">{{pendingCount}}</view>
      <view class="label">待接单</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!stat}}">登录商家账号后展示经营数据</view>
</view>
