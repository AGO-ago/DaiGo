page {
  background: #f5f5f5;
}

.page {
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

.tip {
  margin-bottom: 20rpx;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #ff9800;
  background: #fff8e6;
  border-radius: 12rpx;
}

.bind-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.bind-info {
  flex: 1;
  min-width: 0;
}

.bind-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.bind-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.bind-btn {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
  border-radius: 30rpx;
}

.card {
  padding: 8rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.mall-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.mall-row {
  display: flex;
  align-items: center;
}

.mall-info {
  flex: 1;
  min-width: 0;
}

.mall-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.mall-addr {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #777;
}

.nav-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
  border-radius: 30rpx;
}

.mall-tip {
  margin-top: 16rpx;
  padding-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f6f6f6;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 220rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #222;
}

.field-tip {
  padding: 0 0 20rpx 220rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #999;
}

.logo-box {
  width: 140rpx;
  height: 140rpx;
  overflow: hidden;
  background: #fafafa;
  border: 1rpx dashed #ddd;
  border-radius: 12rpx;
}

.logo {
  width: 100%;
  height: 100%;
}

.logo-placeholder {
  width: 100%;
  height: 100%;
  line-height: 140rpx;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

.save {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
  border-radius: 44rpx;
}

.save.disabled {
  opacity: 0.6;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
