page {
  background: #f5f5f5;
}

.page {
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

.card {
  padding: 8rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f6f6f6;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #222;
}

.image-box {
  width: 160rpx;
  height: 160rpx;
  background: #fafafa;
  border: 1rpx dashed #ddd;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview {
  width: 100%;
  height: 100%;
}

.placeholder {
  width: 100%;
  height: 100%;
  line-height: 160rpx;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

.picker {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #222;
}

.arrow {
  font-size: 30rpx;
  color: #ccc;
}

.save {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
  border-radius: 44rpx;
}

.save.disabled {
  opacity: 0.6;
}
