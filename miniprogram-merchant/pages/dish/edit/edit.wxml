<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">菜品图</text>
      <view class="image-box" bindtap="chooseImage">
        <image class="preview" wx:if="{{form.image}}" src="{{form.image}}" mode="aspectFill" />
        <view class="placeholder" wx:else>{{uploading ? '上传中…' : '＋ 上传'}}</view>
      </view>
    </view>

    <view class="field">
      <text class="label">菜品名称</text>
      <input class="input" placeholder="如：宫保鸡丁盖饭" maxlength="64"
             data-field="name" value="{{form.name}}" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">所属分类</text>
      <picker class="picker" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">
          {{categoryNames[categoryIndex] || '请选择分类'}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="label">售价（元）</text>
      <input class="input" type="digit" placeholder="0.00"
             data-field="price" value="{{form.price}}" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">原价（元）</text>
      <input class="input" type="digit" placeholder="选填，用于划线价"
             data-field="originalPrice" value="{{form.originalPrice}}" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">排序</text>
      <input class="input" type="number" placeholder="越小越靠前"
             data-field="sort" value="{{form.sort}}" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">描述</text>
      <input class="input" placeholder="口味、食材等" maxlength="200"
             data-field="description" value="{{form.description}}" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">上架</text>
      <switch checked="{{form.status === 1}}" color="#ff5722" bindchange="onStatusChange" />
    </view>
  </view>

  <!-- 菜品规格：加价叠加到售价，用户下单时选择 -->
  <view class="card spec-card" wx:if="{{id}}">
    <view class="spec-title">菜品规格（选填）</view>
    <view class="spec-row" wx:for="{{specs}}" wx:key="id">
      <view class="spec-name">{{item.name}}</view>
      <view class="spec-price">{{item.price > 0 ? '+¥' + item.price : '不加价'}}</view>
      <view class="spec-status {{item.status === 1 ? 'on' : ''}}"
            data-id="{{item.id}}" data-status="{{item.status}}" bindtap="toggleSpec">
        {{item.status === 1 ? '启用' : '停用'}}
      </view>
      <view class="spec-del" data-id="{{item.id}}" bindtap="removeSpec">删除</view>
    </view>
    <view class="spec-empty" wx:if="{{!specs.length}}">暂无规格，用户可直接下单</view>
    <view class="spec-add-row">
      <input class="spec-input" placeholder="规格名，如 大份" maxlength="32"
             data-field="newSpecName" value="{{newSpecName}}" bindinput="onSpecInput" />
      <input class="spec-input price" type="digit" placeholder="加价"
             data-field="newSpecPrice" value="{{newSpecPrice}}" bindinput="onSpecInput" />
      <view class="spec-add-btn" bindtap="addSpec">添加</view>
    </view>
  </view>

  <view class="save {{saving ? 'disabled' : ''}}" bindtap="save">保存</view>
</view>
