page {
  background: #f5f5f5;
}

.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.unbound {
  margin: 200rpx 48rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 20rpx;
}

.unbound-text {
  font-size: 30rpx;
  color: #333;
}

.unbound-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background: #ffffff;
}

.tool-btn {
  margin-left: 20rpx;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: #ff5722;
  border: 1rpx solid #ffd6c7;
  border-radius: 26rpx;
}

.category-manage {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 8rpx;
  background: #ffffff;
  border-top: 1rpx solid #f5f5f5;
}

.cat-chip {
  display: flex;
  align-items: center;
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #555;
  background: #f7f7f7;
  border-radius: 26rpx;
}

.cat-del {
  margin-left: 12rpx;
  color: #bbb;
}

.empty-chip {
  padding: 10rpx 0 20rpx;
  font-size: 24rpx;
  color: #999;
}

.group {
  margin: 20rpx 24rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.group-count {
  font-size: 22rpx;
  color: #999;
}

.dish {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #fafafa;
}

.dish:last-child {
  border-bottom: none;
}

.dish.off {
  opacity: 0.6;
}

.img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 500;
  color: #222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.price {
  margin-top: 8rpx;
}

.now {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff2d3c;
}

.origin {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #bbb;
  text-decoration: line-through;
}

.ops {
  flex-shrink: 0;
  text-align: right;
}

.status-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #999;
  background: #f2f2f2;
  border-radius: 24rpx;
}

.status-btn.on {
  color: #4caf50;
  background: #eef8f0;
}

.op-row {
  margin-top: 14rpx;
}

.op {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ff5722;
}

.op.danger {
  color: #999;
}

.group-empty {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: #ff5722;
  color: #ffffff;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 87, 34, 0.4);
}
