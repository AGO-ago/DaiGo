page {
  background: #f5f5f5;
}

.page {
  padding: 20rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
}

.head {
  padding: 36rpx 30rpx;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
  border-radius: 16rpx;
}

.head-status {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.head-no {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.head-amount {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.timeline {
  padding-left: 8rpx;
}

.step {
  position: relative;
  padding: 0 0 22rpx 28rpx;
  border-left: 2rpx solid #eee;
}

.step:last-child {
  padding-bottom: 0;
  border-left-color: transparent;
}

.dot {
  position: absolute;
  left: -8rpx;
  top: 6rpx;
  width: 14rpx;
  height: 14rpx;
  background: #ddd;
  border-radius: 50%;
}

.dot.active {
  background: #ff5722;
}

.step-label {
  font-size: 26rpx;
  color: #333;
}

.step-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #aaa;
}

.addr {
  padding: 16rpx;
  font-size: 26rpx;
  color: #444;
  background: #fafafa;
  border-radius: 10rpx;
}

.remark {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff9800;
}

.dish {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-top: 1rpx solid #f7f7f7;
}

.dish:first-of-type {
  border-top: none;
}

.thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.dish-name {
  font-size: 26rpx;
  color: #333;
}

.spec {
  font-size: 22rpx;
  color: #999;
}

.dish-count {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.dish-amount {
  font-size: 26rpx;
  color: #333;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #666;
}

.row.total {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.minus {
  color: #ff5722;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn {
  margin-left: 20rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
}

.btn.ghost {
  color: #ff5722;
  border: 1rpx solid #ff5722;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
