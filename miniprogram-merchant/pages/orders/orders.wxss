page {
  background: #f5f5f5;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  background: #ffffff;
}

.tab {
  flex: 1;
  position: relative;
  padding: 26rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  color: #222;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  background: #ff5722;
  border-radius: 3rpx;
}

.list {
  padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.order {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.status {
  font-size: 24rpx;
  font-weight: 600;
  color: #ff5722;
}

.status-4 {
  color: #4caf50;
}

.status-5 {
  color: #bbb;
}

.status-6 {
  color: #ff9800;
}

.status-7 {
  color: #bbb;
}

.dish {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.dish-name {
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-count {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

.dish-spec {
  font-size: 22rpx;
  color: #999;
}

.dish-amount {
  font-size: 26rpx;
  color: #333;
}

.addr {
  margin-top: 8rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #555;
  background: #fafafa;
  border-radius: 10rpx;
}

.remark {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #ff9800;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.summary-time {
  font-size: 22rpx;
  color: #aaa;
}

.summary-amount {
  text-align: right;
}

.label {
  display: block;
  font-size: 20rpx;
  color: #ff5722;
}

.pay {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f5f5f5;
}

.btn {
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
}

.btn.ghost {
  margin-right: 16rpx;
  color: #666;
  border: 1rpx solid #ddd;
}

.empty {
  padding: 140rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
