page {
  background: #f5f5f5;
}

.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #ff8a5c, #ff5722);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  font-size: 52rpx;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 50%;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.logout {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
}

.login-btn {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  color: #ff5722;
  background: #ffffff;
  border-radius: 32rpx;
}

.card {
  margin: 24rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.bind-card {
  padding: 28rpx 24rpx;
}

.bind-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.bind-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.phone-auth {
  margin-top: 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #ff5722;
  border-radius: 38rpx;
}

.bind-dev-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #ff5722;
}

.bind-dev {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.phone-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 36rpx;
}

.phone-save {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #ff5722;
  border-radius: 36rpx;
}

.pwd-tip {
  padding: 12rpx 0 6rpx;
  font-size: 22rpx;
  color: #999;
}

.pwd-form {
  padding: 12rpx 0 6rpx;
}

.pwd-input {
  height: 80rpx;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
}

.pwd-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ffffff;
  background: #ff5722;
  border-radius: 40rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 44rpx;
  font-size: 32rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-value {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.menu-arrow {
  font-size: 30rpx;
  color: #ccc;
}

.menu-switch {
  transform: scale(0.8);
}

.version {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
