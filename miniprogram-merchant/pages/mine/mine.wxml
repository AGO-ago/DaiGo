<view class="mine">
  <view class="header">
    <block wx:if="{{user}}">
      <view class="name">{{user.nickname || '商家'}}</view>
      <view class="logout" bindtap="onLogout">退出登录</view>
    </block>
    <block wx:else>
      <view class="login-btn" bindtap="onLogin">商家登录</view>
      <view class="tip">登录后管理档口与订单</view>
    </block>
  </view>
</view>
